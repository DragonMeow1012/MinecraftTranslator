{
  "schemaVersion": 1,
  "id": "mctranslator",
  "version": "${version}",
  "name": "Minecraft Translator",
  "description": "Client-side asynchronous translation for legacy Minecraft.",
  "authors": ["borwen"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": { "client": ["com.borwen.mctranslator.legacy.LegacyTranslatorMod"] },
  "mixins": [{ "config": "mctranslator.mixins.json", "environment": "client" }],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.15.2",
    "java": ">=8"
  }
}
